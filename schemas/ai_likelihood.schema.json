{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/bid-compare/ai_likelihood.schema.json",
  "title": "AILikelihoodResult",
  "type": "object",
  "required": ["schema_version", "analysis_type", "method", "documents", "paragraph_scores", "findings", "metadata"],
  "properties": {
    "schema_version": {"type": "string"},
    "analysis_type": {"const": "ai_likelihood"},
    "method": {"type": "string"},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["document_id", "filename", "eligible_paragraphs", "suspicious_paragraphs", "high_paragraphs", "analyzed_chars", "ai_likelihood", "confidence"],
        "properties": {
          "document_id": {"type": "string"},
          "filename": {"type": "string"},
          "eligible_paragraphs": {"type": "integer", "minimum": 0},
          "suspicious_paragraphs": {"type": "integer", "minimum": 0},
          "high_paragraphs": {"type": "integer", "minimum": 0},
          "analyzed_chars": {"type": "integer", "minimum": 0},
          "ai_likelihood": {"type": "number", "minimum": 0, "maximum": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "paragraph_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document_id", "paragraph_id", "score", "confidence", "severity", "text_chars", "source_locator", "signals"],
        "properties": {
          "document_id": {"type": "string"},
          "paragraph_id": {"type": "string"},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "severity": {"enum": ["info", "medium", "high"]},
          "text_chars": {"type": "integer", "minimum": 0},
          "source_locator": {"type": "object"},
          "signals": {"type": "object"}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "type", "severity", "document_id", "source_locator", "summary", "evidence", "metadata"],
        "properties": {
          "finding_id": {"type": "string"},
          "type": {"const": "ai_likelihood"},
          "severity": {"enum": ["medium", "high"]},
          "document_id": {"type": "string"},
          "source_locator": {"type": "object"},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "summary": {"type": "string"},
          "evidence": {"type": "object"},
          "metadata": {"type": "object"}
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["limitations", "non_diagnostic", "excluded_paragraphs", "downweighted_paragraphs", "thresholds"]
    }
  }
}
