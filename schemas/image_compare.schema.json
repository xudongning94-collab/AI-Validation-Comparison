{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/bid-compare/image_compare.schema.json",
  "title": "ImageComparisonResult",
  "type": "object",
  "required": ["schema_version", "compare_type", "documents", "pair_summaries", "findings", "metadata"],
  "properties": {
    "schema_version": {"type": "string"},
    "compare_type": {"const": "image_similarity"},
    "documents": {"type": "array","minItems": 2,"maxItems": 5,"items": {"type": "object","required": ["document_id", "filename", "sha256"],"properties": {"document_id": {"type": "string"},"filename": {"type": "string"},"sha256": {"type": "string", "minLength": 64, "maxLength": 64}}}},
    "pair_summaries": {"type": "array"},
    "findings": {"type": "array","items": {"type": "object","required": ["finding_id", "type", "severity", "document_id", "source_locator", "summary"],"properties": {"finding_id": {"type": "string"},"type": {"const": "image_similarity"},"severity": {"enum": ["high"]},"document_id": {"type": "string"},"peer_document_id": {"type": ["string", "null"]},"source_locator": {"type": "object"},"peer_source_locator": {"type": ["object", "null"]},"score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},"summary": {"type": "string"},"evidence": {"type": "object"},"metadata": {"type": "object"}}}},
    "metadata": {"type": "object"}
  }
}
