{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/bid-compare/feishu-card-template.schema.json",
  "title": "FeishuCardTemplateV2",
  "type": "object",
  "required": ["schema", "header", "body"],
  "properties": {
    "schema": {"const": "2.0"},
    "config": {"type": "object"},
    "header": {
      "type": "object",
      "required": ["title", "template"],
      "properties": {
        "title": {"$ref": "#/$defs/plainText"},
        "subtitle": {"$ref": "#/$defs/plainText"},
        "template": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "body": {
      "type": "object",
      "required": ["elements"],
      "properties": {
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["tag"],
            "properties": {
              "tag": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "plainText": {
      "type": "object",
      "required": ["tag", "content"],
      "properties": {
        "tag": {"const": "plain_text"},
        "content": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
