{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/ocr_evidence.schema.json",
  "title": "OCR Page Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_type", "document_id", "page_number",
    "image_sha256", "engine", "status", "items", "requires_human_review",
    "error", "metadata"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "evidence_type": {"const": "page_ocr"},
    "document_id": {"type": "string", "minLength": 1},
    "page_number": {"type": "integer", "minimum": 1},
    "image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "engine": {"type": "string", "minLength": 1},
    "status": {"enum": ["ok", "failed", "disabled"]},
    "requires_human_review": {"type": "boolean"},
    "error": {"type": ["string", "null"]},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_profile", "selected_profile", "selected_models"],
      "properties": {
        "requested_profile": {"type": ["string", "null"]},
        "selected_profile": {"type": ["string", "null"]},
        "selected_models": {"type": "object"}
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "text", "confidence", "polygon", "bbox", "review_status"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "review_status": {"enum": ["ok", "low-confidence"]},
          "polygon": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "array",
              "prefixItems": [
                {"type": "number", "minimum": 0},
                {"type": "number", "minimum": 0}
              ],
              "minItems": 2,
              "maxItems": 2
            }
          },
          "bbox": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "w", "h"],
            "properties": {
              "x": {"type": "number", "minimum": 0},
              "y": {"type": "number", "minimum": 0},
              "w": {"type": "number", "exclusiveMinimum": 0},
              "h": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        }
      }
    }
  }
}
