{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/bid-compare/signature_compliance.schema.json",
  "title": "SignatureComplianceResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "check_type",
    "document_id",
    "rules",
    "findings",
    "summary",
    "limitations",
    "metadata"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "check_type": {"const": "signature_compliance"},
    "document_id": {"type": "string", "minLength": 1},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id", "title", "status", "relevant_pages",
          "matched_company_name", "matched_signer_name", "matched_date",
          "signature_candidate_ids", "seal_candidate_ids", "finding_ids"
        ],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "review", "failed"]},
          "relevant_pages": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1}
          },
          "matched_company_name": {"type": ["string", "null"]},
          "matched_signer_name": {"type": ["string", "null"]},
          "matched_date": {"type": ["string", "null"], "format": "date"},
          "signature_candidate_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "seal_candidate_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "finding_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string"}
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "finding.schema.json"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_count", "passed_rule_count", "review_rule_count",
        "failed_rule_count", "finding_count"
      ],
      "properties": {
        "rule_count": {"type": "integer", "minimum": 0},
        "passed_rule_count": {"type": "integer", "minimum": 0},
        "review_rule_count": {"type": "integer", "minimum": 0},
        "failed_rule_count": {"type": "integer", "minimum": 0},
        "finding_count": {"type": "integer", "minimum": 0}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "deterministic", "authenticity_check"],
      "properties": {
        "method": {"const": "signature-compliance-rules-v1"},
        "deterministic": {"const": true},
        "authenticity_check": {"const": false}
      }
    }
  }
}
