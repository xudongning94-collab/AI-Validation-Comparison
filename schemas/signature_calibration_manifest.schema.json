{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/bid-compare/signature_calibration_manifest.schema.json",
  "title": "SignatureCandidateCalibrationManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "calibration_id", "privacy", "samples"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "calibration_id": {"type": "string", "minLength": 1},
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include_source_paths"],
      "properties": {"include_source_paths": {"const": false}}
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "document_group_id", "split", "image", "page_number",
          "signature_rois", "annotations"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "document_group_id": {"type": "string", "minLength": 1},
          "split": {"enum": ["calibration", "validation"]},
          "image": {"type": "string", "minLength": 1},
          "page_number": {"type": "integer", "minimum": 1},
          "signature_rois": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {"type": "integer", "minimum": 0},
                {"type": "integer", "minimum": 0},
                {"type": "integer", "minimum": 1},
                {"type": "integer", "minimum": 1}
              ],
              "minItems": 4,
              "maxItems": 4,
              "items": false
            }
          },
          "annotations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "bbox", "ignore"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "kind": {"enum": ["signature", "seal"]},
                "bbox": {"$ref": "#/$defs/bbox"},
                "ignore": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {"type": "number", "minimum": 0},
        "y": {"type": "number", "minimum": 0},
        "w": {"type": "number", "exclusiveMinimum": 0},
        "h": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
