# HiAgent HTTP 节点统一引用的服务地址；不要以斜杠结尾。
BID_COMPARE_API_BASE_URL=http://127.0.0.1:8000

# 工作流侧超时应高于真实样本观测上限，并为网络开销留余量。
BID_COMPARE_API_TIMEOUT_SECONDS=120

# 与服务端 D10 输入边界保持一致。
BID_COMPARE_API_MAX_FILES=5
BID_COMPARE_API_MAX_FILE_MB=50

# 当前 Alpha API 本身不实现鉴权。非本机部署必须由 API 网关或反向代理提供
# HTTPS、身份认证和访问审计；令牌只保存在 HiAgent 密钥管理中，不写入仓库。
BID_COMPARE_API_AUTH_MODE=gateway
BID_COMPARE_API_AUTH_HEADER=Authorization
BID_COMPARE_API_AUTH_SCHEME=Bearer
